# Copy to .env and uncomment what you need:  cp .env.example .env
# Variables already set in the real environment take precedence over .env.

# --- Core ---
# PORT=8787
# HOST=127.0.0.1                 # keep local; expose via `tailscale serve`
# PUBLIC_URL=                    # e.g. https://your-machine.your-tailnet.ts.net (shown in the QR)
# PROJECT_DIR=                   # default working directory for new sessions
# AGENT=claude                  # claude | codex | antigravity | ollama | aider | gemini

# --- Access token (recommended when reachable beyond localhost) ---
# ACCESS_TOKEN=                  # e.g. output of: openssl rand -hex 16

# --- Agent binaries & options ---
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# AGY_BIN=agy
# OLLAMA_BIN=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
# AIDER_BIN=aider
# GEMINI_BIN=gemini
# CODEX_CONTINUE_ARGS=          # opt-in Codex resume, e.g. "resume --last"
# AGY_CONTINUE_ARGS=            # opt-in Antigravity resume
# AGENT_TIMEOUT_MS=1200000      # per-turn cap before the agent is killed (default 20 min). 0 = no cap (for long autonomous tasks; stop via the app/closing the tab).

# --- Speech-to-text ---
# STT_MODE=browser              # browser | whisper | whisper-stream
# STT_CMD=                      # whisper mode: command; {file} = recorded audio path
# STT_STREAM_URL=               # whisper-stream mode: e.g. ws://127.0.0.1:8910/listen
# STT_STREAM_CMD=               # whisper-stream mode: subprocess cmd, e.g. whisper-stream -m ~/models/ggml-base.bin

# --- Sessions ---
# SESSIONS_FILE=                # e.g. ~/.voicebridge/sessions.json (persist across restarts)
# MAX_SESSIONS=200
# FAVORITES=                    # JSON array, e.g. [{"name":"App","projectDir":"/path","agent":"claude"}]

# --- Cloud runner ---
# CLOUD_RUNNER_URL=             # http(s) endpoint that speaks the NDJSON protocol
# CLOUD_RUNNER_TOKEN=

# --- Web Push (real OS notifications) ---  generate with: node scripts/gen-vapid-keys.js
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Voice layer: spoken style, narrator, voice agent (docs/configuration.md) ---
# Voice sessions answer in a short, spoken style. These are the defaults:
# VOICE_MODE_DEFAULT=1
# VOICE_STYLE_PROMPT=           # override the instruction; Turkish example:
# VOICE_STYLE_PROMPT="Telefonda konuşur gibi cevap ver. 1–4 kısa cümle. Kod, dosya yolu, link, markdown okuma. Uzun detay gerekiyorsa bir dosyaya yaz ve sadece 'detayı şu dosyaya yazdım' de. Kullanıcının dilinde cevap ver."
# VOICE_STYLE_PROMPT_FILE=      # or read it from a text file

# Summarizer for progress updates, short final summaries and the voice agent.
# Easiest: the `claude` CLI already logged in on this machine (no API key).
# SUMMARY_PROVIDER=claude-cli
# SUMMARY_MODEL=haiku           # CLI model alias
# SUMMARY_TIMEOUT_MS=20000
# Or the Anthropic API directly (faster, billed to the key; never commit .env):
# SUMMARY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-haiku-5-5
# Other options: SUMMARY_PROVIDER=openai with SUMMARY_BASE_URL / SUMMARY_API_KEY,
# or SUMMARY_PROVIDER=ollama with SUMMARY_OLLAMA_URL. Without a summarizer the
# bridge reads replies as they stream (filtered), as before.

# Narrator (spoken progress / summaries / approvals)
# NARRATOR=1
# NARRATOR_LANG=tr              # en | tr — built-in spoken templates
# NARRATOR_INTERVAL_MS=30000    # progress update cadence; 0 = off
# NARRATOR_FINAL_MIN_CHARS=280  # shorter replies are read as-is
# NARRATOR_LOG=1                # log each summary's added latency

# Voice agent: "stop, add X, then continue", routing by session name,
# spoken confirmation before commit/push/delete. Off by default.
# VOICE_AGENT=1
